# Copy to .env and fill in. Run ./generate-secrets.sh for the two JWTs —
# see README.md.

# Postgres superuser password. Also used for the authenticator role that
# PostgREST connects as, and supabase_admin that Realtime connects as.
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Symmetric secret PostgREST and Realtime verify the JWTs below against.
# Keep this private — anyone holding it can mint their own valid tokens.
# openssl rand -base64 32
JWT_SECRET=

# Long-lived JWTs signed with JWT_SECRET, role claims "anon" / "service_role".
# ANON_KEY is what the app ships as VITE_SUPABASE_ANON_KEY — it is public by
# design (it lands in the browser bundle); RLS is the actual access control.
# SERVICE_ROLE_KEY bypasses RLS, so treat it like a root password.
# ./generate-secrets.sh '<JWT_SECRET>'
ANON_KEY=
SERVICE_ROLE_KEY=

# Realtime's at-rest key for tenant config. Must be exactly 16 characters.
# openssl rand -hex 8
DB_ENC_KEY=

# Phoenix (Realtime) secret key base — needs to be long, 64+ characters.
# openssl rand -base64 48
SECRET_KEY_BASE=
